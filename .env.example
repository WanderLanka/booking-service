# Booking service environment
PORT=3009
# MongoDB
# Use service-specific first; will fallback to MONGO_URI
+
+# MongoDB
+# Use service-specific first; will fallback to MONGO_URI
MONGO_URI=+BOOKING_DB_NAME=wanderlanka_booking
+
+# Generic fallback
+# MONGO_URI=
+
+# CORS origins (comma separated)
+CORS_ORIGINS=http://localhost:5173,exp://127.0.0.1:8081
+
+# Logging
+LOG_LEVEL=info
GUIDE_SERVICE_URL=http://192.168.8.142:3005
